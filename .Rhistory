df <- df |>
mutate(
segmentos = case_when(
p48 == "1- Soy graduadx o entregué la tesina y estoy esperando fecha de defensa" ~ "Graduado",
p48 == "2-Soy estudiante" & p27 < anio_encuesta - duracion_carrera ~ "Estudiante demorado",
p48 ==  "2-Soy estudiante" & p27 >= anio_encuesta - duracion_carrera   ~ "Estudiante a termino",
TRUE ~ "Otra situación" )
)
# Paso 1: definimos dos vectores con el anio de la ecuesta y la duración de la carrera
anio_encuesta <- 2024
duracion_carrera <- 5
df <- df |>
mutate(
segmentos = case_when(
p48 == "1- Soy graduadx o entregué la tesina y estoy esperando fecha de defensa" ~ "Graduado",
p48 == "2-Soy estudiante" & p27 < anio_encuesta - duracion_carrera ~ "Estudiante demorado",
p48 ==  "2-Soy estudiante" & p27 >= anio_encuesta - duracion_carrera   ~ "Estudiante a termino",
TRUE ~ "Otra situación" )
)
# ¿Que edad tienen cada segmento?
df |>
tabyl(edad_r,segmentos) |>
adorn_percentages("col") |>
adorn_pct_formatting(digits = 0)
df |>
tabyl(edad_r,segmentos)
df |>
tabyl(edad_r)
hist(df$edad_r)
df$edad_r
hist(df$edad_r, breaks = "Sturges")
ggplot(df, aes(x= edad))+
geom_histogram(binwidth = 5)
df |>
tabyl(edad_r)
summary(df$edad)
library(esquisse)
install.packages("esquisse")
# La cátedra propone analizar estos tramos ¿Por qué?
# exploramos la edad de manera discreta y vemos su distribución en un
df |>
ggplot(aes(x= edad))+
geom_histogram(binwidth = 1)
summary(df$edad)
library(esquisse)
esquisser(df)
variables_interes <- df |> select(edad,id,genero,genero_r)
esquisser(variables_interes)
