segmentos_lugar_de_residencia <- df |>
mutate(p10_r = factor(
levels = c("1- En San Martín",
"2- En otro partido del Gran Bs. As.",
"3- En CABA",
"4- En resto Prov. de Bs As",
"5- Otros",
"9- NS/NC"),
labels = c("En San Martín",
"En otro partido del GBA.",
"En CABA",
"En resto Prov. de Bs As",
"Otros",
"NS/NC"),
ordered = T)
) |>
group_by(segmentos,p10_r) |>
summarise(estudiantes_n = n_distinct(id)) |>
mutate(estudiantes_prop = round(estudiantes_n/sum(estudiantes_n)*100,1))
