p48 == "2-Soy estudiante" & p27 < anio_encuesta - duracion_carrera ~ "Estudiante demorado",
p48 ==  "2-Soy estudiante" & p27 >= anio_encuesta - duracion_carrera   ~ "Estudiante a termino",
