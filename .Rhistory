segmentos_niveleducativo_madre <- df |>
mutate(p12=factor(p12,
levels = c("1- Sin instrucción o Primario incompleto",
"2- Primario completo","3- Secundario incompleto",
"4- Secundario completo", "5- Terciario/universitario incompleto",
"6- Terciario/universitario completo", "9- NS/NR"),
labels = c("Sin instrucción o Primario incompleto",
"Primario completo","Secundario incompleto",
"Secundario completo", "Terciario/universitario incompleto",
"Terciario/universitario completo", "NS/NR")))|>
group_by(segmentos,p12) |>
summarise(estudiantes_n = n_distinct(id)) |>
mutate(estudiantes_prop = round(estudiantes_n/sum(estudiantes_n)*100,1))
